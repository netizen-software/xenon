<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="services_manager_view">
    <property name="orientation">vertical</property>
    <style><class name="utility-view"/></style>
    <property name="spacing">18</property>
    <property name="margin-top">24</property>
    <property name="margin-bottom">24</property>
    <property name="margin-start">24</property>
    <property name="margin-end">24</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">12</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">system-run-symbolic</property>
            <property name="pixel-size">32</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">2</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Services Manager</property>
                <property name="xalign">0</property>
                <style><class name="view-title"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="status_label">
                <property name="label">Loading system services...</property>
                <property name="xalign">0</property>
                <style><class name="status-line"/></style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="refresh_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text">Refresh services</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">12</property>
        <style><class name="column-header"/></style>
        <child>
          <object class="GtkLabel">
            <property name="label">Unit</property>
            <property name="hexpand">true</property>
            <property name="xalign">0</property>
            <style><class name="heading"/></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">Runtime</property>
            <property name="width-request">120</property>
            <property name="xalign">1</property>
            <style><class name="heading"/></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">Enablement</property>
            <property name="width-request">140</property>
            <property name="xalign">1</property>
            <style><class name="heading"/></style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">true</property>
        <property name="hscrollbar-policy">never</property>
        <style><class name="data-list"/></style>
        <child>
          <object class="GtkListBox" id="service_list">
            <property name="selection-mode">single</property>
            <property name="show-separators">true</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">8</property>
        <property name="halign">end</property>
        <style><class name="action-bar"/></style>
        <child>
          <object class="GtkButton" id="start_button">
            <property name="label">Start</property>
            <property name="sensitive">false</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="stop_button">
            <property name="label">Stop</property>
            <property name="sensitive">false</property>
            <style><class name="destructive-action"/></style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="enable_button">
            <property name="label">Enable</property>
            <property name="sensitive">false</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="disable_button">
            <property name="label">Disable</property>
            <property name="sensitive">false</property>
            <style><class name="destructive-action"/></style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
